# Copy this file to .env only if you use a tool that loads environment files.
# Otherwise set these values in your terminal before running Django.
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true
# Add the computer's LAN IP when sharing locally, for example 192.168.1.20.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
